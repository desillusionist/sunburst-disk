{
  "name": "sunburst-disk",
  "productName": "Sunburst Disk",
  "private": true,
  "version": "0.3.1",
  "description": "A macOS disk usage analyzer with a visual sunburst, safe review tools and live updates for the current folder.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:quicklook": "swiftc electron/quicklook-preview.swift -framework Cocoa -framework QuickLookUI -o electron/quicklook-preview && chmod 755 electron/quicklook-preview",
    "build:icon": "bash scripts/build-icon.sh",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --lib",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "rust:test:all": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --lib --bins -- -D warnings",
    "rust:lint:all": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
