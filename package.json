{
  "name": "sunburst-disk",
  "productName": "Sunburst Disk",
  "private": true,
  "version": "0.2.1",
  "description": "A macOS disk usage analyzer with a visual sunburst, safe review tools and live updates for the current folder.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:fsevents": "swiftc electron/fsevents-watcher.swift -o electron/fsevents-watcher && chmod 755 electron/fsevents-watcher",
    "build:quicklook": "swiftc electron/quicklook-preview.swift -framework Cocoa -framework QuickLookUI -o electron/quicklook-preview && chmod 755 electron/quicklook-preview",
    "build:openwith": "swiftc electron/openwith-applications.swift -framework AppKit -o electron/openwith-applications && chmod 755 electron/openwith-applications",
    "electron:dev": "concurrently \"VITE_DEV_SERVER_URL=http://localhost:3000 vite --port 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && npm run build:fsevents && npm run build:quicklook && npm run build:openwith && electron-builder --mac",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.sunburstdisk.app",
    "productName": "Sunburst Disk",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "electron/fsevents-watcher",
      "electron/quicklook-preview",
      "electron/openwith-applications"
    ],
    "mac": {
      "icon": "assets/SunburstDisk.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "dir"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
